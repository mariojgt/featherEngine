    "@react-three/postprocessing": "^2.19.1",
    "@react-three/uikit": "^1.0.73",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@xyflow/react": "^12.3.5",
    "ai": "^6.0.193",
    "clsx": "^2.1.1",
    "dockview-react": "^6.6.1",
    "fflate": "^0.8.3",
    "framer-motion": "^11.15.0",
    "ktx2-encoder": "^0.5.3",
    "lucide-react": "^0.468.0",
    "meshoptimizer": "^1.1.1",
    "postprocessing": "^6.37.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.171.0",
    "three-bvh-csg": "^0.0.17",
    "three-mesh-bvh": "^0.7.8",
    "three-stdlib": "^2.36.1",
    "yjs": "^13.6.32",
    "zod": "^4.4.3",
    "zustand": "^5.0.2"
