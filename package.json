    "uikit:pack": "node scripts/uikit/pack.mjs",
    "cinematic:score": "node scripts/generate-last-light-score.mjs",
    "cinematic:crystal:preview": "node scripts/render-cinematic.mjs --template crystal-slice --quality Epic --preview --times 0.7,1.35,3.4,5.7,8.4,10.5",
    "cinematic:crystal:render": "node scripts/render-cinematic.mjs --template crystal-slice --quality Epic --fps 60",
    "cinematic:preview": "node scripts/render-cinematic.mjs --preview",
