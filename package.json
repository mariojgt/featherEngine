    "cinematic:blackthorn:preview": "node scripts/render-cinematic.mjs --template blackthorn --preview",
    "cinematic:blackthorn:render": "node scripts/render-cinematic.mjs --template blackthorn",
    "cinematic:neon:assets": "node scripts/generate-neon-afterlight-assets.mjs && node scripts/generate-neon-afterlight-score.mjs",
    "cinematic:neon:preview": "node scripts/render-cinematic.mjs --template neon-afterlight --quality Epic --preview",
    "cinematic:verdant:preview": "node scripts/render-cinematic.mjs --template verdant --preview",
    "cinematic:verdant:render": "node scripts/render-cinematic.mjs --template verdant",
    "cinematic:neon:render": "node scripts/render-cinematic.mjs --template neon-afterlight --quality Epic",
    "store:pull": "node scripts/store/pull.mjs",
    "store:publish": "node scripts/store/publish.mjs",
    "pretest": "npm run store:pull",
    "store:capture": "node scripts/store/capture.mjs",
    "test:cinderfall": "node scripts/e2e/cinderfall.mjs",
    "store:add": "vite-node scripts/store/add.mts",
    "check:unused": "tsc -p tsconfig.app.json --noEmit && node --test scripts/tests/unused-source.test.mjs && node scripts/check-unused-source.mjs",
    "measure:engine": "node scripts/e2e/engine-performance.mjs",
    "test:startup": "node scripts/e2e/deferred-panels.mjs"
